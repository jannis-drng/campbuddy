# Supabase — Backend für Login und gespeicherte Touren [BALD].
#
# Diese Datei ist die Vorlage. Echte Werte gehören in .env.local,
# die von .gitignore ausgeschlossen ist.
#
# Beide Werte hier sind BEWUSST öffentlich: der publishable Key ist dafür
# gemacht, im Browser-Bundle zu stehen. Der Schutz kommt aus Row Level
# Security in der Datenbank, nicht aus der Geheimhaltung des Schlüssels.
#
# Der `sb_secret_…`-Schlüssel darf NIEMALS hier oder sonst im Frontend
# auftauchen — er umgeht RLS und gibt Vollzugriff.

VITE_SUPABASE_URL=https://DEIN-PROJEKT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
