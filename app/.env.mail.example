# Zugangsdaten für den Mailweg an die Gemeinden.
#
# Kopieren nach .env.mail.local und ausfüllen. Diese Datei liest ausschliesslich
# der Läufer, über `node --env-file=.env.mail.local`. Bewusst NICHT .env.local:
# die liest Vite mit, und was dort mit VITE_ beginnt, landet im Browser-Bündel.
# Ein Passwort oder Schlüssel hat dort nichts zu suchen.
#
# .env.mail.local ist über `*.local` von Git ausgeschlossen.
#
# Aufteilung: Zoho empfängt, Resend versendet. Das ist Absicht — tausend Mails
# von einer frischen Domain über normales SMTP landen im Spam und können die
# Domain auf Blocklisten bringen. Ein Versanddienst hat den Ruf, den wir dafür
# brauchen; das Postfach bleibt, wo es hingehört.

# ---- Empfangen: Zoho Mail (IMAP, ab Lite-Abo) ----
# imap.zoho.eu bei europäischem Konto, imap.zoho.com bei amerikanischem.
# Welches es ist, verrät die Adresse beim Anmelden (mail.zoho.eu / .com).
IMAP_HOST=imap.zoho.eu
IMAP_PORT=993
IMAP_USER=contact@camping-map.com
# App-Passwort aus Zoho (Sicherheit → App-Passwörter), NICHT das Kontopasswort.
IMAP_PASSWORD=

# ---- Versenden: Resend ----
RESEND_API_KEY=
# Bei Resend verifizierte Absenderadresse. Eine eigene Unterdomain empfiehlt
# sich: Zohos MX-Eintrag auf der Hauptdomain bleibt unberührt, und ein
# missratener Versand beschädigt nicht den Ruf deiner normalen Adresse.
MAIL_VON=CampBuddy <anfrage@send.camping-map.com>

# ---- Zuordnung der Antworten ----
# {{bfs}} wird je Gemeinde eingesetzt. So trägt jede Antwort ihre Gemeinde
# selbst mit sich, und die Zuordnung muss nie geraten werden.
#
# Voraussetzung ist, dass Zoho Plus-Adressen ins selbe Postfach legt — genau
# das prüft die Testmail an contact+bfs4551@camping-map.com. Falls nicht,
# braucht es einen Catch-all (Zoho Admin → Domains → Catch-all-Adresse); der
# Aufbau der Adresse bleibt derselbe.
MAIL_ANTWORT_AN=contact+bfs{{bfs}}@camping-map.com

# ---- Absender im Text ----
MAIL_ABSENDER=Jannis Döring
MAIL_PROJEKT_URL=https://camping-map.com

# ---- Schonende Grenzen ----
# Tageshöchstzahl. Tausend Mails an Schweizer Verwaltungen an einem Tag sind
# weder nötig noch klug; verteilt über Wochen ist der Rücklauf ohnehin besser
# zu bearbeiten.
MAIL_PRO_TAG=80
