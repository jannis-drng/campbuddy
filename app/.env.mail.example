# Zugangsdaten für den Mailweg an die Gemeinden.
#
# Kopieren nach .env.mail.local und ausfüllen. Diese Datei liest ausschliesslich
# der Läufer, über `node --env-file=.env.mail.local`. Bewusst NICHT .env.local:
# die liest Vite mit, und was dort mit VITE_ beginnt, landet im Browser-Bündel.
# Ein Passwort hat dort nichts zu suchen.
#
# .env.mail.local ist über `*.local` von Git ausgeschlossen.

# ---- Zoho: empfangen UND versenden ----
# imap.zoho.eu / smtp.zoho.eu bei europäischem Konto, .com bei amerikanischem.
# Welches es ist, verrät die Adresse beim Anmelden (mail.zoho.eu / .com).
IMAP_HOST=imap.zoho.eu
IMAP_PORT=993
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
# Das Konto, an dem sich IMAP und SMTP anmelden. Das ist ein echtes
# Benutzerkonto — meist admin@…, nicht contact@. Ein Alias oder eine Zoho-
# Gruppe hat kein eigenes Passwort; wer sich damit anzumelden versucht,
# bekommt "Invalid credentials" und sucht den Fehler beim Passwort.
MAIL_USER=admin@camping-map.com
# App-Passwort aus Zoho (Sicherheit → App-Passwörter), NICHT das Kontopasswort.
# Es gehört zum Konto oben und gilt für IMAP wie SMTP.
MAIL_PASSWORT=

# Die Adresse, die im Kopf der Mail steht — sie darf vom Anmeldekonto
# abweichen. In Zoho muss sie dafür unter "Absenderadressen" eingetragen und
# bestätigt sein, sonst weist SMTP sie zurück.
MAIL_ABSENDERADRESSE=contact@camping-map.com

# ---- Zuordnung der Antworten ----
# {{bfs}} wird je Gemeinde eingesetzt und landet im Reply-To. So trägt jede
# Antwort ihre Gemeinde selbst mit sich, und die Zuordnung muss nie geraten
# werden. Diese Adresse wird NICHT angelegt — Plus-Adressen entstehen von
# selbst und landen im Postfach von contact@.
MAIL_ANTWORT_AN=contact+bfs{{bfs}}@camping-map.com

# ---- Absender im Text ----
MAIL_ABSENDER=Jannis Döring
MAIL_PROJEKT_URL=https://camping-map.com

# ---- Schonende Grenzen ----
# Zoho erlaubt bis zu 1000 Mails am Tag, drosselt aber dynamisch nach
# Missbrauchsverdacht — und ausdrücklich ist der Dienst für "normale
# geschäftliche Kommunikation" gedacht, nicht für Massenversand. 50 am Tag
# sind unauffällig, brauchen für tausend Gemeinden aber gut drei Wochen.
# Das ist kein Nachteil: der Rücklauf will ohnehin gelesen werden.
MAIL_PRO_TAG=50

# ---- Nur falls Zoho drosselt: Resend als Ausweichweg ----
# Leer lassen. Wird er gesetzt, versendet der Läufer über Resend statt über
# Zoho — dann braucht es zusätzlich eine verifizierte Absenderdomain.
RESEND_API_KEY=
MAIL_VON=CampBuddy <anfrage@send.camping-map.com>
